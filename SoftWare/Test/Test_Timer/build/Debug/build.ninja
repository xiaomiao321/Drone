  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\files\25_26_winter\plane\Test_Timer\build\Debug\cmake\stm32cubemx && D:\STM32CubeCLT\STM32CubeCLT_1.18.0\CMake\bin\cmake.exe --regenerate-during-build -SD:\files\25_26_winter\plane\Test_Timer -BD:\files\25_26_winter\plane\Test_Timer\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util

